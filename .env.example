# Copy to .env and adjust for TWS or IB Gateway.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=97
DEFAULT_TICKER=AAPL
PORT=8097
MASSIVE_API_KEY=replace_with_your_massive_api_key
# Generate with `openssl rand -hex 32`; use the same value for
# DAIDAI_TAPE_CONTROL_TOKEN in DaiDai's local .env.
TAPE_EXTERNAL_REPLAY_TOKEN=replace_with_your_private_random_token

# Experimental Kronos plugin. Only the tape backend connects to this URL.
KRONOS_ENABLED=true
KRONOS_URL=http://10.17.17.99:8787
# Copy the Spark's private key onto the machine RUNNING THE TAPE BACKEND.
# No key belongs in browser storage, URLs, or a committed .env file.
KRONOS_API_KEY_FILE=~/.config/tape-reading-tool/kronos-api-key
KRONOS_PATHS=32
KRONOS_SESSION=extended
# Public/domain URLs should use HTTPS. Private IP HTTP is unencrypted LAN traffic.
# KRONOS_ALLOW_INSECURE_HTTP=true

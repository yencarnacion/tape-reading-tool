# Copy to .env and adjust for TWS or IB Gateway.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=97
DEFAULT_TICKER=AAPL
PORT=8097
MASSIVE_API_KEY=replace_with_your_massive_api_key
# Generate with `openssl rand -hex 32`; configure your local replay
# controller to send this token in X-Tape-Control-Token.
TAPE_EXTERNAL_REPLAY_TOKEN=replace_with_your_private_random_token

# Experimental Kronos plugin. Only the tape backend connects to this URL.
KRONOS_ENABLED=true
KRONOS_URL=http://127.0.0.1:8787
# Install your forecast service key on the machine running this backend.
# No key belongs in browser storage, URLs, or a committed .env file.
KRONOS_API_KEY_FILE=~/.config/tape-reading-tool/kronos-api-key
KRONOS_PATHS=32
KRONOS_SESSION=extended
# Public/domain URLs should use HTTPS. Private IP HTTP is unencrypted LAN traffic.
# KRONOS_ALLOW_INSECURE_HTTP=true

# Optional options context. Empty URL means ADR + tape only; no options network calls.
# The gateway implements docs/OPTIONS_GATEWAY.md and owns provider credentials.
TAPE_OPTIONS_GATEWAY_URL=
TAPE_OPTIONS_GATEWAY_TOKEN=
# Prepared historical options can be replayed completely offline.
TAPE_OPTIONS_REPLAY_DIR=data/options-replay

# Optional position overlay from a local status adapter; unset disables it.
# See docs/LOCAL_INTEGRATIONS.md for its small JSON contract.
TAPE_POSITION_STATUS_URL=

# Optional server-side market-data gateway. Public default remains IBKR.
MARKET_DATA_PROVIDER=ibkr
MARKET_DATA_GATEWAY_URL=
MARKET_DATA_GATEWAY_TOKEN=
